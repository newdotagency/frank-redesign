---
import Base from '../../layouts/Base.astro';
import Route from '../../v2104/UseCaseRoute.jsx';
import { USECASES } from '../../v2104/usecases/index.js';
import LIVE from '../../v2104/usecases/live.json';
export function getStaticPaths() {
  return [...Object.values(USECASES), ...Object.values(LIVE)].map(d => ({ params: { slug: d.slug }, props: { slug: d.slug, title: d.title, description: d.description } }));
}
const { slug, title, description } = Astro.props;
---
<Base title={title} description={description}>
  <div id="root"><Route slug={slug} client:only="react" /></div>
</Base>
