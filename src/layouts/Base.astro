---
import '../index.css';
import '../motion.css';
import '../v9/v9.css';
import '../v2104/v19.css';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Not indexed for now: remove this tag, public/robots.txt and the X-Robots-Tag in public/_headers to go live -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/frank-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Figtree:wght@500&family=Geist+Mono:wght@300;400&family=Lora:ital,wght@0,400;0,500;1,400;1,500&family=Homemade+Apple&family=Caveat:wght@600&family=Kalam:wght@700&display=swap" rel="stylesheet" />
    <!-- TODO-DESIGN markers, after every link to a page that is not signed off yet:
           red    = still the old live site (not migrated);
           yellow = migrated here, design still in review: features, benefits, blog posts, authors, case studies, comparisons, legal;
           green  = a use-case page built strictly from the doc "[Frank] Templates" (so far: Discovery calls);
           red    also marks an interview template in the menu that has no page yet (its link is an anchor, "#template-<id>", on the home page's wheel):
                  the doc has no content for it. When a template's page is built from the doc, link it in MegaMenu.jsx and add it to the green rule.
         Delete this <style> block to hide the dots. A page that is approved leaves the yellow list below (as the home, pricing, docs,
         product updates, blog list and comparison pages already have); a live-site page leaves red when it is added to src/lib/sitePaths.js. -->
    <style is:global>
      a[href^="https://www.hifrank.ai/"]:not([tabindex="-1"])::after,
      a[href^="https://hifrank.ai/"]:not([tabindex="-1"])::after,
      a[href^="/features/"]:not([tabindex="-1"])::after,
      a[href^="/benefits/"]:not([tabindex="-1"])::after,
      a[href^="/industries/"]:not([tabindex="-1"])::after,
      a[href^="/roles/"]:not([tabindex="-1"])::after,
      a[href^="/blog/"]:not([tabindex="-1"])::after,
      a[href^="/author/"]:not([tabindex="-1"])::after,
      a[href^="/case-study"]:not([tabindex="-1"])::after,
      a[href^="/competitors/"]:not([tabindex="-1"])::after,
      a[href="/privacy-policy"]:not([tabindex="-1"])::after,
      a[href="/terms-of-service"]:not([tabindex="-1"])::after,
      a[href="/cookies-settings"]:not([tabindex="-1"])::after,
      a[href*="#template-"]:not([tabindex="-1"])::after {
        content: ""; display: inline-block; flex: none; width: 7px; height: 7px; margin-left: 6px;
        border-radius: 9999px; background: #e5322d; vertical-align: middle; box-shadow: 0 0 0 2px rgba(229, 50, 45, 0.18);
      }
      /* in review: yellow (listed after the red rule so it wins) */
      a[href^="/features/"]:not([tabindex="-1"])::after,
      a[href^="/benefits/"]:not([tabindex="-1"])::after,
      a[href^="/industries/"]:not([tabindex="-1"])::after,
      a[href^="/roles/"]:not([tabindex="-1"])::after,
      a[href^="/blog/"]:not([tabindex="-1"])::after,
      a[href^="/author/"]:not([tabindex="-1"])::after,
      a[href^="/case-study"]:not([tabindex="-1"])::after,
      a[href^="/competitors/"]:not([tabindex="-1"])::after,
      a[href="/privacy-policy"]:not([tabindex="-1"])::after,
      a[href="/terms-of-service"]:not([tabindex="-1"])::after,
      a[href="/cookies-settings"]:not([tabindex="-1"])::after {
        background: #f5b800; box-shadow: 0 0 0 2px rgba(245, 184, 0, 0.25);
      }
      /* built from the doc: green */
      a[href="/use-case/ai-discovery-calls"]:not([tabindex="-1"])::after {
        content: ""; display: inline-block; flex: none; width: 7px; height: 7px; margin-left: 6px;
        border-radius: 9999px; background: #2fb35a; vertical-align: middle; box-shadow: 0 0 0 2px rgba(47, 179, 90, 0.22);
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
