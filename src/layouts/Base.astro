---
import '../index.css';
import '../motion.css';
import '../v9/v9.css';
import '../v2104/v19.css';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Not indexed for now: remove this tag, public/robots.txt and the X-Robots-Tag in public/_headers to go live -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href="/frank-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Figtree:wght@500&family=Geist+Mono:wght@300;400&family=Lora:ital,wght@0,400;0,500;1,400;1,500&family=Homemade+Apple&family=Caveat:wght@600&family=Kalam:wght@700&display=swap" rel="stylesheet" />
    <!-- TODO-DESIGN markers, after every link to a page that is not finished:
           red    = still the old live site (not started);
           yellow = built here, design in progress (now: the /features/ pages and /product-updates).
         Delete this <style> block to hide the dots. A live-site page leaves red when it is added to src/lib/sitePaths.js; move a
         page's path from the yellow rule to nothing (delete it) once its design is done. -->
    <style is:global>
      a[href^="https://www.hifrank.ai/"]:not([tabindex="-1"])::after,
      a[href^="https://hifrank.ai/"]:not([tabindex="-1"])::after,
      a[href^="/features/"]:not([tabindex="-1"])::after,
      a[href^="/product-updates"]:not([tabindex="-1"])::after {
        content: ""; display: inline-block; flex: none; width: 7px; height: 7px; margin-left: 6px;
        border-radius: 9999px; background: #e5322d; vertical-align: middle; box-shadow: 0 0 0 2px rgba(229, 50, 45, 0.18);
      }
      /* in progress: yellow (listed after the red rule so it wins) */
      a[href^="/features/"]:not([tabindex="-1"])::after,
      a[href^="/product-updates"]:not([tabindex="-1"])::after {
        background: #f5b800; box-shadow: 0 0 0 2px rgba(245, 184, 0, 0.25);
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
